{
  "name": "web3d-agent-cli",
  "version": "0.1.0",
  "description": "面向 Three.js 与 Python 后端的规则驱动编程智能体 CLI",
  "type": "module",
  "bin": {
    "web3d-agent": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build-cli.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "esbuild": "0.28.2"
  },
  "license": "MIT",
  "overrides": {
    "zod": "4.6.7"
  }
}
